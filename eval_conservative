import sys
from pathlib import Path
sys.path.insert(0, str(Path(__file__).parent))

import torch
import numpy as np
from models.content_aware_model import ContentAwareActor
from models.content_aware_env_fcc import ContentAwareEnvFCC
from models.fcc_trace_loader import FCCTraceLoader

class ConservativePolicy:
    def __init__(self, model):
        self.model = model
        self.model.eval()
    
    def select_action(self, state, buffer):
        net = torch.FloatTensor(state['network']).unsqueeze(0)
        cont = torch.FloatTensor(state['content']).unsqueeze(0)
        vmaf = torch.FloatTensor(state['vmaf']).unsqueeze(0)
        
        with torch.no_grad():
            probs, _ = self.model(net, cont, vmaf)
            action = probs.argmax(dim=1).item()
        
        # Safety rules
        if buffer < 5.0:
            action = min(action, 1)  # Max 750 kbps
        elif buffer < 10.0:
            action = min(action, 2)  # Max 1850 kbps
        elif buffer < 20.0:
            action = min(action, 3)  # Max 2850 kbps
        
        return action

model = ContentAwareActor(state_dim=(6, 8), action_dim=6, content_dim=2)
checkpoint = torch.load('results/fcc_training/checkpoint_400.pth')
model.load_state_dict(checkpoint['model_state_dict'])

policy = ConservativePolicy(model)

loader = FCCTraceLoader(
    fcc_trace_dir='data/fcc_traces',
    train_file='data/network_traces/fcc/splits/fcc_train.txt',
    val_file='data/network_traces/fcc/splits/fcc_val.txt',
    test_file='data/network_traces/fcc/splits/fcc_test.txt'
)

env = ContentAwareEnvFCC(
    fcc_trace_loader=loader,
    features_file='data/features/si_ti_features.json',
    vmaf_file='data/vmaf/vmaf_table.json',
    video_dir='data/videos',
    mode='test'
)

print("Testing with conservative policy...")
rewards = []
rebuffers = []

for ep in range(20):
    state = env.reset()
    ep_reward = 0
    ep_rebuf = 0
    done = False
    
    while not done:
        action = policy.select_action(state, env.buffer)
        state, reward, done, info = env.step(action)
        ep_reward += reward
        ep_rebuf += info['rebuffer_time']
    
    rewards.append(ep_reward)
    rebuffers.append(ep_rebuf)

print(f"Conservative Policy:")
print(f"  Reward:     {np.mean(rewards):+.2f} ± {np.std(rewards):.2f}")
print(f"  Rebuffering: {np.mean(rebuffers):.2f}s")